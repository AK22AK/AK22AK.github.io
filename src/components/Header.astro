---
import Ginger from './Ginger.astro';

const navItems = [
  { href: '/', label: '首页' },
  { href: '/blog/', label: '文章' },
  { href: '/projects/', label: '项目' },
  { href: '/daily-news/', label: '资讯' },
  { href: '/about/', label: '关于' },
];

const mobilePrimaryItems = [
  { href: '/', label: '首页' },
  { href: '/blog/', label: '文章' },
  { href: '/projects/', label: '项目' },
  { href: '/daily-news/', label: '资讯' },
  { href: '/about/', label: '关于' },
];
---

<header class="header">
  <div class="container header-inner">
    <a href="/" class="logo">AK22AK<Ginger /></a>
    <nav class="nav">
      {navItems.map(item => (
        <a href={item.href}>{item.label}</a>
      ))}
    </nav>
    <button
      class="mobile-nav-toggle"
      type="button"
      aria-expanded="false"
      aria-controls="site-mobile-menu"
      data-mobile-nav-toggle
    >
      <span class="mobile-nav-toggle-icon" aria-hidden="true"></span>
      <span>菜单</span>
    </button>
  </div>
  <nav id="site-mobile-menu" class="mobile-nav-panel" aria-label="移动端主导航" hidden data-mobile-nav-panel>
    <div class="mobile-nav-links">
      {mobilePrimaryItems.map(item => (
        <a class="mobile-nav-link" href={item.href}>{item.label}</a>
      ))}
    </div>
  </nav>
</header>

<script>
  const mobileNavBreakpoint = window.matchMedia('(min-width: 769px)');

  document.querySelectorAll('[data-mobile-nav-toggle]').forEach((button) => {
    const panelId = button.getAttribute('aria-controls');
    const panel = panelId ? document.getElementById(panelId) : null;

    if (!panel) {
      return;
    }

    const closePanel = () => {
      button.setAttribute('aria-expanded', 'false');
      panel.hidden = true;
    };

    const openPanel = () => {
      button.setAttribute('aria-expanded', 'true');
      panel.hidden = false;
    };

    button.addEventListener('click', () => {
      const isOpen = button.getAttribute('aria-expanded') === 'true';
      if (isOpen) {
        closePanel();
      } else {
        openPanel();
      }
    });

    panel.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', closePanel);
    });

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') {
        closePanel();
      }
    });

    document.addEventListener('click', (event) => {
      const target = event.target;
      if (!(target instanceof Node)) {
        return;
      }

      const isOpen = button.getAttribute('aria-expanded') === 'true';
      if (isOpen && !button.contains(target) && !panel.contains(target)) {
        closePanel();
      }
    });

    mobileNavBreakpoint.addEventListener('change', (event) => {
      if (event.matches) {
        closePanel();
      }
    });
  });
</script>
