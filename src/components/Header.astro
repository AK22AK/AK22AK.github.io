---
import Ginger from './Ginger.astro';

const navItems = [
  { href: '/', label: '首页' },
  { href: '/about', label: '关于' },
  { href: '/projects', label: '项目' },
  { href: '/blog', label: '想法' },
];
---

<header class="header">
  <div class="container header-inner">
    <a href="/" class="logo">AK22AK<Ginger /></a>
    <nav class="nav">
      {navItems.map(item => (
        <a href={item.href}>{item.label}</a>
      ))}
      <div class="nav-dropdown">
        <a href="/daily-news/" class="nav-dropdown-trigger">资讯</a>
        <div class="nav-dropdown-menu" aria-label="资讯快速入口">
          <a href="/daily-news/">日报首页</a>
          <a href="/daily-news/topic/tech/">科技</a>
          <a href="/daily-news/topic/sports/">体育</a>
          <a href="/daily-news/archive/">归档</a>
          <a href="/daily-news/sources/">来源</a>
        </div>
      </div>
    </nav>
  </div>
</header>
