---
import { getCollection } from 'astro:content';
import fs from 'node:fs';
import path from 'node:path';
import type { TopicConfig } from '../../../../lib/dailyNews';

export async function getStaticPaths() {
  const topicsPath = path.resolve('./src/data/daily-news-topics.json');
  const topicsConfig = JSON.parse(fs.readFileSync(topicsPath, 'utf-8'));
  const topics = (topicsConfig.topics as TopicConfig[]).filter(topic => topic.active !== false);
  const newsData = await getCollection('daily-news');
  const dateEntries = newsData.filter(entry => entry.id !== 'topics');

  return dateEntries.flatMap(entry => topics.map(topic => ({
    params: { date: entry.data.date, id: topic.id },
    props: { topic },
  })));
}

const { topic } = Astro.props as { topic: TopicConfig };
const { date } = Astro.params;
const targetHref = `/daily-news/${date}/?field=${encodeURIComponent(topic.id)}`;
---

<!DOCTYPE html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta http-equiv="refresh" content={`0; url=${targetHref}`} />
    <link rel="canonical" href={targetHref} />
    <title>{topic.name}资讯 - AK22AK</title>
  </head>
  <body>
    <p>正在跳转到 <a href={targetHref}>{topic.name}资讯</a>。</p>
    <script is:inline define:vars={{ targetHref }}>
      window.location.replace(targetHref);
    </script>
  </body>
</html>
