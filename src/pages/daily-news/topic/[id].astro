---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import fs from 'node:fs';
import path from 'node:path';
import {
  buildGenericTopicPageView,
  buildSportsTopicPageView,
  getDailyNewsHomeHref,
  getDisplayLabel,
  getSourceName,
  getSportsSubtopicRenderMode,
  type DailyNewsData,
  type TopicConfig,
} from '../../../lib/dailyNews';

export async function getStaticPaths() {
  const topicsPath = path.resolve('./src/data/daily-news-topics.json');
  const topicsConfig = JSON.parse(fs.readFileSync(topicsPath, 'utf-8'));
  const topics = (topicsConfig.topics as TopicConfig[])
    .filter(topic => topic.active !== false && ['tech', 'sports'].includes(topic.id));
  return topics.map(topic => ({
    params: { id: topic.id },
    props: { topic },
  }));
}

const { topic } = Astro.props as { topic: TopicConfig };
const topicsPath = path.resolve('./src/data/daily-news-topics.json');
const topicsConfig = JSON.parse(fs.readFileSync(topicsPath, 'utf-8'));
const allTopics = topicsConfig.topics as TopicConfig[];

const newsData = await getCollection('daily-news');
const dateEntries = newsData.filter(entry => entry.id !== 'topics');
dateEntries.sort((a, b) => b.data.date.localeCompare(a.data.date));

const url = new URL(Astro.request.url);
const selectedDate = url.searchParams.get('date');
const availableDates = dateEntries.map(entry => entry.data.date);
const currentDate = selectedDate && availableDates.includes(selectedDate)
  ? selectedDate
  : (availableDates[0] || '');
const currentIndex = availableDates.indexOf(currentDate);
const previousDate = availableDates[currentIndex + 1];
const nextDate = currentIndex > 0 ? availableDates[currentIndex - 1] : undefined;
const currentEntry = dateEntries.find(entry => entry.data.date === currentDate);
const currentData = currentEntry?.data as DailyNewsData | undefined;

if (!currentData) {
  throw new Error('Missing daily news data');
}

const sourceMeta = new Map(
  allTopics.flatMap(entry => (entry.sources || []).map(source => [
    source.id,
    { name: source.name, url: source.url, topic: entry.id },
  ] as const)),
);
const isSports = topic.id === 'sports';
const genericView = !isSports ? buildGenericTopicPageView(currentData, topic) : undefined;
const sportsView = isSports ? buildSportsTopicPageView(currentData, topic) : undefined;
const view = sportsView || genericView!;
const updateText = view.updatedAtLabel ? `${view.weekdayLabel} · ${view.updatedAtLabel}` : view.weekdayLabel;
const otherItemsSectionId = isSports ? 'other-items' : 'other';
const otherItemsNavLabel = isSports ? '其他值得看' : '其他';
const matchTimeLabels: Record<string, string> = {
  yesterday: '昨天',
  last_night: '昨晚',
  this_morning: '今早',
  today: '今天',
  tonight: '今晚',
};
const matchStatusLabels: Record<string, string> = {
  result: '赛果',
  fixture: '赛程',
};

function formatMatchDateTime(value: string | undefined) {
  if (!value) return '';
  const date = new Date(value);
  if (Number.isNaN(date.getTime())) return value.replace('T', ' ');
  return date.toLocaleString('zh-CN', {
    month: 'numeric',
    day: 'numeric',
    hour: '2-digit',
    minute: '2-digit',
    hour12: false,
  });
}

function getMatchTimeLabel(status: { timeLabel?: string; startTime?: string; resultTime?: string }) {
  const absoluteTime = status.resultTime || status.startTime;
  if (absoluteTime) return formatMatchDateTime(absoluteTime);
  return matchTimeLabels[status.timeLabel || ''] || status.timeLabel || '';
}

function getMatchTitle(status: {
  title: string;
  home?: string;
  away?: string;
  playerA?: string;
  playerB?: string;
  score?: string;
}) {
  if (status.home && status.away) return `${status.home} ${status.score || 'vs'} ${status.away}`;
  if (status.playerA && status.playerB) return `${status.playerA} ${status.score || 'vs'} ${status.playerB}`;
  return status.title;
}

function getMatchNote(status: { reason?: string; note?: string }) {
  return status.reason || status.note || '';
}

function getOtherItemLabel(ref: { label?: string; item: { subtopic?: string } }) {
  return getDisplayLabel(topic, ref.label, ref.item.subtopic) || topic.name;
}

function getSportsSubtopicNavLabel(subtopic: { id: string; label: string }) {
  return subtopic.id === 'other' ? '其他项目' : subtopic.label;
}

function getTopicSourceId(source: { id?: string; name: string }) {
  return source.id || source.name;
}

function getTopicSourceName(source: { id?: string; name: string }) {
  const sourceId = getTopicSourceId(source);
  if (sourceId === 'fantasy-football-scout') return 'FPL';
  return sourceMeta.get(sourceId)?.name || source.name;
}

function getTopicSourceDescription(source: { id?: string; name: string; description?: string }) {
  const sourceId = getTopicSourceId(source);
  if (sourceId === 'fantasy-football-scout') return '英超范特西';
  return source.description || '当日来源';
}
---

<BaseLayout title={`${topic.name} - ${view.dateLabel} 日报 - AK22AK`} description={`AK22AK ${topic.name} 每日资讯`} variant="news">
  <div class={`daily-redesign daily-redesign--topic ${isSports ? 'daily-redesign--sports' : 'daily-redesign--generic'}`}>
    <aside class="daily-side">
      <a class="daily-back-link" href={getDailyNewsHomeHref(currentDate)}>← 返回日报</a>
      <section class="daily-date-block">
        <p class="daily-side-label">Daily</p>
        <div class="daily-date-line">
          {previousDate ? <a href={`/daily-news/topic/${topic.id}/?date=${previousDate}`} aria-label="前一天">‹</a> : <span></span>}
          <strong>{view.dateLabel}</strong>
          {nextDate ? <a href={`/daily-news/topic/${topic.id}/?date=${nextDate}`} aria-label="后一天">›</a> : <span></span>}
        </div>
        <p>{updateText} 更新</p>
      </section>

      <section>
        <p class="daily-side-label">{isSports ? 'On This Topic' : 'On This Page'}</p>
        <nav class="daily-side-nav" aria-label={`${topic.name} 导航`}>
          {isSports ? (
            <>
              <a class="active" href="#overview" data-daily-section-link><span>总览</span><small>{sportsView!.overview.length}</small></a>
              {sportsView!.subtopics.map(subtopic => (
                <a href={`#${subtopic.id}`} data-daily-section-link><span>{getSportsSubtopicNavLabel(subtopic)}</span><small>{subtopic.storylines.length || subtopic.refs.length}</small></a>
              ))}
              <a href={`#${otherItemsSectionId}`} data-daily-section-link><span>{otherItemsNavLabel}</span><small>{sportsView!.otherItems.length}</small></a>
              <a href="#sources" data-daily-section-link><span>来源</span><small>{sportsView!.sources.length}</small></a>
            </>
          ) : (
            <>
              <a class="active" href="#overview" data-daily-section-link><span>总览</span>{genericView!.overviewSummary ? null : <small>{genericView!.overview.length}</small>}</a>
              <a href="#morning" data-daily-section-link><span>早报</span><small>{genericView!.morningBriefs.length}</small></a>
              <a href="#lines" data-daily-section-link><span>今日主线</span><small>{genericView!.dailyLines.length}</small></a>
              <a href="#other" data-daily-section-link><span>其他</span><small>{genericView!.otherItems.length}</small></a>
              <a href="#sources" data-daily-section-link><span>来源</span><small>{genericView!.sources.length}</small></a>
            </>
          )}
        </nav>
      </section>
    </aside>

    <main class="daily-content">
      <div class="daily-mobile-date">
        <span>‹ {view.dateLabel} ›</span>
        <span>{view.weekdayLabel}{view.updatedAtLabel ? ` · ${view.updatedAtLabel}` : ''}</span>
      </div>
      <nav class="daily-mobile-picker" aria-label={`${topic.name} 快捷导航`}>
        {isSports ? (
          <>
            <a class="active" href="#overview" data-daily-section-link>总览</a>
            {sportsView!.subtopics.map(subtopic => <a href={`#${subtopic.id}`} data-daily-section-link>{getSportsSubtopicNavLabel(subtopic)}</a>)}
            <a href={`#${otherItemsSectionId}`} data-daily-section-link>{otherItemsNavLabel}</a>
          </>
        ) : (
          <>
            <a class="active" href="#overview" data-daily-section-link>总览</a>
            <a href="#morning" data-daily-section-link>早报</a>
            <a href="#lines" data-daily-section-link>主线</a>
            <a href="#other" data-daily-section-link>其他</a>
          </>
        )}
      </nav>

      <header class="daily-hero daily-topic-hero">
        <div class="daily-meta">
          <span>{topic.name}</span>
          <span>{view.stats.rawItems} 条原文</span>
          <span>{view.stats.sources} 个来源</span>
          <span>{isSports ? `${sportsView!.stats.subtopics} 个子主题` : `${genericView!.stats.dailyLines} 条主线`}</span>
        </div>
        <h1>{topic.name}</h1>
      </header>

      {isSports ? (
        <>
          <section id="overview" class="daily-section daily-anchor">
            <div class="daily-section-head">
              <h2>今日总览</h2>
            </div>
            <ol class="daily-overview-list">
              {sportsView!.overview.map(entry => (
                <li>
                  <a href={entry.href}>
                    <span class="daily-rank">{entry.rank}</span>
                    <strong>{entry.text}</strong>
                  </a>
                </li>
              ))}
            </ol>
          </section>

          {sportsView!.subtopics.map(subtopic => (
            <section id={subtopic.id} class="daily-section daily-anchor daily-story-group">
              <div class="daily-group-head">
                <span>{subtopic.label}</span>
                <div>
                  <h2>{subtopic.title}</h2>
                  <p>{subtopic.summary}</p>
                </div>
              </div>

              {getSportsSubtopicRenderMode(subtopic) === 'storylines' ? (
                <div class="daily-sports-line-list">
                  {subtopic.storylines.map(line => {
                    const sourceNames = Array.from(new Set(line.refs.map(ref => getSourceName(ref.item.source, sourceMeta))));
                    const refsId = `sports-refs-${subtopic.id}-${line.id}`;
                    return (
                      <article class="daily-sports-line">
                        <h3>{line.title}</h3>
                        <p>{line.summary}</p>
                        <div class="daily-ref-details">
                          <div class="daily-ref-controls">
                            <button
                              class="daily-ref-toggle"
                              type="button"
                              aria-label="展开引用"
                              aria-expanded="false"
                              aria-controls={refsId}
                              data-daily-ref-toggle
                            >
                              <svg aria-hidden="true" viewBox="0 0 16 16">
                                <path d="M6 4l4 4-4 4" />
                              </svg>
                            </button>
                            <span class="daily-ref-chip-row" aria-label={`${line.refs.length} 条引用来源`}>
                              {sourceNames.map(name => <span>{name}</span>)}
                            </span>
                          </div>
                          <div id={refsId} class="daily-ref-list" hidden>
                            {line.refs.map(ref => (
                              <a class="daily-ref-link" href={ref.item.url} target="_blank" rel="noopener noreferrer">
                                <span>{getSourceName(ref.item.source, sourceMeta)}</span>
                                <strong>{ref.item.title}</strong>
                              </a>
                            ))}
                          </div>
                        </div>
                      </article>
                    );
                  })}
                </div>
              ) : (
                <div class="daily-story-list">
                  {subtopic.refs.map(ref => (
                    <a class="daily-story" href={ref.item.url} target="_blank" rel="noopener noreferrer">
                      <strong>{ref.readerTitle}</strong>
                      {ref.readerSummary ? <p>{ref.readerSummary}</p> : null}
                      <span class="daily-ref-chip-row daily-story-source-chips">
                        <span>{getSourceName(ref.item.source, sourceMeta)}</span>
                      </span>
                    </a>
                  ))}
                </div>
              )}
            </section>
          ))}
        </>
      ) : (
        <>
          <section id="overview" class="daily-section daily-anchor">
            <div class="daily-section-head">
              <h2>今日总览</h2>
            </div>
            {genericView!.overviewSummary ? (
              <p class="daily-overview-summary">{genericView!.overviewSummary}</p>
            ) : (
              <ol class="daily-overview-list">
                {genericView!.overview.map(entry => (
                  <li>
                    <a href={entry.href}>
                      <span class="daily-rank">{entry.rank}</span>
                      <strong>{entry.text}</strong>
                    </a>
                  </li>
                ))}
              </ol>
            )}
          </section>

          <section id="morning" class="daily-section daily-anchor">
            <div class="daily-section-head">
              <h2>早报</h2>
            </div>
            <div class="daily-morning-list">
              {genericView!.morningBriefs.map(brief => (
                <a href={brief.url} target="_blank" rel="noopener noreferrer">
                  <strong><span class="daily-morning-source">{brief.sourceName}</span><span class="daily-morning-divider">｜</span>{brief.title}</strong>
                </a>
              ))}
            </div>
          </section>

          <section id="lines" class="daily-section daily-anchor">
            <div class="daily-section-head">
              <h2>今日主线</h2>
            </div>
            {genericView!.dailyLines.map(line => {
              const sourceNames = Array.from(new Set(line.refs.map(ref => getSourceName(ref.item.source, sourceMeta))));
              const refsId = `refs-${line.id}`;
              return (
                <article id={line.id} class="daily-story-group daily-anchor">
                  <div class="daily-group-head">
                    <div>
                      <h2>{line.title}</h2>
                      <p>{line.summary}</p>
                    </div>
                  </div>
                  <div class="daily-ref-details">
                    <div class="daily-ref-controls">
                      <button
                        class="daily-ref-toggle"
                        type="button"
                        aria-label="展开引用"
                        aria-expanded="false"
                        aria-controls={refsId}
                        data-daily-ref-toggle
                      >
                        <svg aria-hidden="true" viewBox="0 0 16 16">
                          <path d="M6 4l4 4-4 4" />
                        </svg>
                      </button>
                      <span class="daily-ref-chip-row" aria-label={`${line.refs.length} 条引用来源`}>
                        {sourceNames.map(name => <span>{name}</span>)}
                      </span>
                    </div>
                    <div id={refsId} class="daily-ref-list" hidden>
                      {line.refs.map(ref => (
                        <a class="daily-ref-link" href={ref.item.url} target="_blank" rel="noopener noreferrer">
                          <span>{getSourceName(ref.item.source, sourceMeta)}</span>
                          <strong>{ref.item.title}</strong>
                        </a>
                      ))}
                    </div>
                  </div>
                </article>
              );
            })}
          </section>
        </>
      )}

      <section id={otherItemsSectionId} class="daily-section daily-anchor">
        <div class="daily-section-head">
          <h2>其他值得看</h2>
        </div>
        <div class="daily-other-list">
          {(isSports ? sportsView!.otherItems : genericView!.otherItems).map(ref => (
            <a href={ref.item.url} target="_blank" rel="noopener noreferrer">
              <span>{getOtherItemLabel(ref)}</span>
              <strong>{ref.readerTitle}</strong>
              <em>{getSourceName(ref.item.source, sourceMeta)}</em>
            </a>
          ))}
        </div>
      </section>

      <section id="sources" class="daily-section daily-anchor">
        <div class="daily-section-head">
          <h2>来源</h2>
        </div>
        <div class="daily-source-list">
          {(isSports ? sportsView!.sources : genericView!.sources).map(source => (
            <div class="daily-source-row">
              <strong>{getTopicSourceName(source)}</strong>
              <span>{getTopicSourceDescription(source)}</span>
              <em>{source.count} 条</em>
            </div>
          ))}
        </div>
      </section>
    </main>
  </div>
</BaseLayout>

<script>
  const links = Array.from(document.querySelectorAll('[data-daily-section-link]'));
  const ids = links
    .map(link => link.getAttribute('href'))
    .filter((href) => href?.startsWith('#'))
    .map((href) => href.slice(1));
  const sections = Array.from(new Set(ids))
    .map(id => document.getElementById(id))
    .filter(Boolean);
  let ticking = false;
  let activeId = '';

  function setActive(id, center = false) {
    if (activeId === id && !center) return;
    activeId = id;
    links.forEach(link => {
      const isActive = link.getAttribute('href') === `#${id}`;
      link.classList.toggle('active', isActive);
      if (isActive && center && link.closest('.daily-mobile-picker')) {
        link.scrollIntoView({ inline: 'center', block: 'nearest', behavior: 'auto' });
      }
    });
  }

  function updateActive() {
    ticking = false;
    let nextId = sections[0]?.id || '';
    const offset = window.innerWidth <= 820 ? 220 : 142;
    sections.forEach(section => {
      if (section.getBoundingClientRect().top <= offset) nextId = section.id;
    });
    if (nextId) setActive(nextId, false);
  }

  document.addEventListener('scroll', () => {
    if (ticking) return;
    ticking = true;
    requestAnimationFrame(updateActive);
  }, { passive: true });
  window.addEventListener('resize', updateActive);
  links.forEach(link => {
    link.addEventListener('click', () => {
      const href = link.getAttribute('href') || '';
      if (href.startsWith('#')) setActive(href.slice(1), true);
    });
  });
  document.querySelectorAll('[data-daily-ref-toggle]').forEach(button => {
    const controls = button.getAttribute('aria-controls');
    const panel = controls ? document.getElementById(controls) : null;
    if (!panel) return;
    button.addEventListener('click', () => {
      const expanded = button.getAttribute('aria-expanded') === 'true';
      button.setAttribute('aria-expanded', String(!expanded));
      button.setAttribute('aria-label', expanded ? '展开引用' : '收起引用');
      panel.hidden = expanded;
    });
  });
  updateActive();
</script>
