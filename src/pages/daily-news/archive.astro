---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import fs from 'node:fs';
import path from 'node:path';
import {
  formatDateLabel,
  getDailyNewsHomeHref,
  getTopicHref,
  type TopicConfig,
} from '../../lib/dailyNews';

const topicsPath = path.resolve('./src/data/daily-news-topics.json');
const topicsConfig = JSON.parse(fs.readFileSync(topicsPath, 'utf-8'));
const topics = (topicsConfig.topics as TopicConfig[])
  .filter(topic => topic.active !== false && ['tech', 'sports'].includes(topic.id));

const newsData = await getCollection('daily-news');
const dateEntries = newsData.filter(entry => entry.id !== 'topics');
dateEntries.sort((a, b) => b.data.date.localeCompare(a.data.date));

const currentDate = dateEntries[0]?.data.date || '';
const currentDateLabel = formatDateLabel(currentDate);
const entriesByMonth = new Map<string, typeof dateEntries>();
for (const entry of dateEntries) {
  const month = entry.data.date.slice(0, 7);
  if (!entriesByMonth.has(month)) entriesByMonth.set(month, []);
  entriesByMonth.get(month)!.push(entry);
}
const sortedMonths = Array.from(entriesByMonth.keys()).sort((a, b) => b.localeCompare(a));
const topicStats = topics.map(topic => {
  let rawItems = 0;
  let days = 0;
  for (const entry of dateEntries) {
    const topicItems = entry.data.items.filter(item => item.topic === topic.id);
    if (topicItems.length > 0) {
      rawItems += topicItems.length;
      days += 1;
    }
  }
  return { ...topic, rawItems, days };
});
---

<BaseLayout title="归档 - AK22AK 日报" description="AK22AK 日报历史归档" variant="news">
  <div class="daily-redesign daily-redesign--single">
    <aside class="daily-side">
      <a class="daily-back-link" href={getDailyNewsHomeHref(currentDate)}>← 返回日报</a>
      <section class="daily-date-block">
        <p class="daily-side-label">Daily</p>
        <div class="daily-date-line">
          <span></span>
          <strong>{currentDateLabel}</strong>
          <span></span>
        </div>
        <p>最新一期</p>
      </section>
      <section>
        <p class="daily-side-label">On This Page</p>
        <nav class="daily-side-nav" aria-label="归档导航">
          <a class="active" href="#topics" data-daily-section-link><span>主题</span><small>{topicStats.length}</small></a>
          <a href="#dates" data-daily-section-link><span>日期</span><small>{dateEntries.length}</small></a>
        </nav>
      </section>
    </aside>

    <main class="daily-content">
      <div class="daily-mobile-date">
        <span>{currentDateLabel}</span>
        <span>最新一期</span>
      </div>
      <nav class="daily-mobile-picker" aria-label="归档快捷导航">
        <a class="active" href="#topics" data-daily-section-link>主题</a>
        <a href="#dates" data-daily-section-link>日期</a>
      </nav>

      <header class="daily-hero">
        <div class="daily-meta">
          <span>{dateEntries.length} 期日报</span>
          <span>{topicStats.length} 个主题</span>
        </div>
        <h1>归档</h1>
      </header>

      <section id="topics" class="daily-section daily-anchor">
        <div class="daily-section-head">
          <h2>主题</h2>
        </div>
        <div class="daily-topic-list">
          {topicStats.map(topic => (
            <a class="daily-topic-row" href={getTopicHref(topic.id, currentDate)}>
              <strong>{topic.name}</strong>
              <div>
                <p>{topic.rawItems} 条原文 · {topic.days} 天有更新</p>
                <span>{topic.description}</span>
              </div>
            </a>
          ))}
        </div>
      </section>

      <section id="dates" class="daily-section daily-anchor">
        <div class="daily-section-head">
          <h2>日期</h2>
        </div>
        {sortedMonths.map(month => {
          const entries = entriesByMonth.get(month) || [];
          return (
            <section class="daily-story-group">
              <div class="daily-group-head">
                <span>{month}</span>
                <div>
                  <h2>{month.replace('-', '.')}</h2>
                  <p>{entries.length} 期日报</p>
                </div>
              </div>
              <div class="daily-archive-list">
                {entries.map(entry => (
                  <a href={getDailyNewsHomeHref(entry.data.date)}>{formatDateLabel(entry.data.date)}</a>
                ))}
              </div>
            </section>
          );
        })}
      </section>
    </main>
  </div>
</BaseLayout>

<script>
  const links = Array.from(document.querySelectorAll('[data-daily-section-link]'));
  const ids = links
    .map(link => link.getAttribute('href'))
    .filter((href) => href?.startsWith('#'))
    .map((href) => href.slice(1));
  const sections = Array.from(new Set(ids))
    .map(id => document.getElementById(id))
    .filter(Boolean);
  let ticking = false;
  let activeId = '';

  function setActive(id, center = false) {
    if (activeId === id && !center) return;
    activeId = id;
    links.forEach(link => {
      const isActive = link.getAttribute('href') === `#${id}`;
      link.classList.toggle('active', isActive);
      if (isActive && center && link.closest('.daily-mobile-picker')) {
        link.scrollIntoView({ inline: 'center', block: 'nearest', behavior: 'auto' });
      }
    });
  }

  function updateActive() {
    ticking = false;
    let nextId = sections[0]?.id || '';
    const offset = window.innerWidth <= 900 ? 170 : 142;
    sections.forEach(section => {
      if (section.getBoundingClientRect().top <= offset) nextId = section.id;
    });
    if (nextId) setActive(nextId, false);
  }

  document.addEventListener('scroll', () => {
    if (ticking) return;
    ticking = true;
    requestAnimationFrame(updateActive);
  }, { passive: true });
  window.addEventListener('resize', updateActive);
  links.forEach(link => {
    link.addEventListener('click', () => {
      const href = link.getAttribute('href') || '';
      if (href.startsWith('#')) setActive(href.slice(1), true);
    });
  });
  updateActive();
</script>
