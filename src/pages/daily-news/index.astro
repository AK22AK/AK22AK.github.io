---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import fs from 'node:fs';
import path from 'node:path';
import {
  buildDailyNewsHomeView,
  type DailyNewsData,
  type TopicConfig,
} from '../../lib/dailyNews';

const topicsPath = path.resolve('./src/data/daily-news-topics.json');
const topicsConfig = JSON.parse(fs.readFileSync(topicsPath, 'utf-8'));
const topics = topicsConfig.topics as TopicConfig[];

const newsData = await getCollection('daily-news');
const dateEntries = newsData.filter(entry => entry.id !== 'topics');
dateEntries.sort((a, b) => b.data.date.localeCompare(a.data.date));

const url = new URL(Astro.request.url);
const selectedDate = url.searchParams.get('date');
const availableDates = dateEntries.map(entry => entry.data.date);
const currentDate = selectedDate && availableDates.includes(selectedDate)
  ? selectedDate
  : (availableDates[0] || '');
const currentIndex = availableDates.indexOf(currentDate);
const previousDate = availableDates[currentIndex + 1];
const nextDate = currentIndex > 0 ? availableDates[currentIndex - 1] : undefined;
const currentEntry = dateEntries.find(entry => entry.data.date === currentDate);
const currentData = currentEntry?.data as DailyNewsData | undefined;

if (!currentData) {
  throw new Error('Missing daily news data');
}

const view = buildDailyNewsHomeView(currentData, topics, availableDates);
const updateText = view.updatedAtLabel ? `${view.weekdayLabel} · ${view.updatedAtLabel}` : view.weekdayLabel;
---

<BaseLayout title={`${view.dateLabel} 日报 - AK22AK`} description="AK22AK 每日资讯入口" variant="news">
  <div class="daily-redesign daily-redesign--home">
    <aside class="daily-side">
      <section class="daily-date-block">
        <p class="daily-side-label">Daily</p>
        <div class="daily-date-line">
          {previousDate ? <a href={`/daily-news/?date=${previousDate}`} aria-label="前一天">‹</a> : <span></span>}
          <strong>{view.dateLabel}</strong>
          {nextDate ? <a href={`/daily-news/?date=${nextDate}`} aria-label="后一天">›</a> : <span></span>}
        </div>
        <p>{updateText} 更新</p>
      </section>

      <section>
        <p class="daily-side-label">On This Page</p>
        <nav class="daily-side-nav" aria-label="日报导航">
          <a class="active" href="#highlights" data-daily-section-link><span>热点</span><small>{view.highlights.length}</small></a>
          <a href="#topics" data-daily-section-link><span>主题</span><small>{view.topics.length}</small></a>
          <a href="#archive" data-daily-section-link><span>归档</span><small>→</small></a>
        </nav>
      </section>
    </aside>

    <main class="daily-content">
      <div class="daily-mobile-date">
        <span>‹ {view.dateLabel} ›</span>
        <span>{view.weekdayLabel}{view.updatedAtLabel ? ` · ${view.updatedAtLabel}` : ''}</span>
      </div>
      <nav class="daily-mobile-picker" aria-label="日报快捷导航">
        <a class="active" href="#highlights" data-daily-section-link>热点</a>
        <a href="#topics" data-daily-section-link>主题</a>
        <a href="#archive" data-daily-section-link>归档</a>
      </nav>

      <header class="daily-hero">
        <div class="daily-meta">
          <span>{view.stats.rawItems} 条原文</span>
          <span>{view.stats.topics} 个主题</span>
          <span>{view.stats.highlights} 条热点</span>
        </div>
        <h1>{view.dateLabel} 日报</h1>
      </header>

      <section id="highlights" class="daily-section daily-anchor">
        <div class="daily-section-head">
          <h2>今日热点</h2>
        </div>
        <ol class="daily-highlight-list">
          {view.highlights.map(highlight => (
            <li>
              <a href={highlight.href}>
                <span class="daily-rank">{highlight.rank}</span>
                <div>
                  <strong>{highlight.title}</strong>
                  <p>{highlight.summary}</p>
                  <em>{highlight.label}</em>
                </div>
              </a>
            </li>
          ))}
        </ol>
      </section>

      <section id="topics" class="daily-section daily-anchor">
        <div class="daily-section-head">
          <h2>主题</h2>
        </div>
        <div class="daily-topic-list">
          {view.topics.map(topic => (
            <a class="daily-topic-row" href={topic.href}>
              <strong>{topic.name}</strong>
              <div>
                <p>{topic.rawItems} 条原文 · {topic.sources} 个来源</p>
                <span>{topic.tags.join(' / ')}</span>
              </div>
            </a>
          ))}
        </div>
      </section>

      <section id="archive" class="daily-section daily-anchor">
        <div class="daily-section-head">
          <h2>归档</h2>
        </div>
        <div class="daily-archive-list">
          {view.archive.map(entry => (
            <a href={entry.href} class={entry.date === currentDate ? 'active' : ''}>{entry.label}</a>
          ))}
          <a href="/daily-news/archive/">更多日期</a>
        </div>
      </section>
    </main>
  </div>
</BaseLayout>

<script>
  const links = Array.from(document.querySelectorAll('[data-daily-section-link]'));
  const ids = links
    .map(link => link.getAttribute('href'))
    .filter((href) => href?.startsWith('#'))
    .map((href) => href.slice(1));
  const sections = Array.from(new Set(ids))
    .map(id => document.getElementById(id))
    .filter(Boolean);
  let ticking = false;
  let activeId = '';

  function setActive(id, center = false) {
    if (activeId === id && !center) return;
    activeId = id;
    links.forEach(link => {
      const isActive = link.getAttribute('href') === `#${id}`;
      link.classList.toggle('active', isActive);
      if (isActive && center && link.closest('.daily-mobile-picker')) {
        link.scrollIntoView({ inline: 'center', block: 'nearest', behavior: 'auto' });
      }
    });
  }

  function updateActive() {
    ticking = false;
    let nextId = sections[0]?.id || '';
    const offset = window.innerWidth <= 820 ? 220 : 142;
    sections.forEach(section => {
      if (section.getBoundingClientRect().top <= offset) nextId = section.id;
    });
    if (nextId) setActive(nextId, false);
  }

  document.addEventListener('scroll', () => {
    if (ticking) return;
    ticking = true;
    requestAnimationFrame(updateActive);
  }, { passive: true });
  window.addEventListener('resize', updateActive);
  links.forEach(link => {
    link.addEventListener('click', () => {
      const href = link.getAttribute('href') || '';
      if (href.startsWith('#')) setActive(href.slice(1), true);
    });
  });
  updateActive();
</script>
